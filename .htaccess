# ─── DESHABILITAR LITESPEED CACHE para HTML ───────────────────────────────────
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>

# ─── HTML: sin caché ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# ─── CSS / JS / imágenes: caché largo (cache-busting por versión) ─────────────
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|ico|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>