# HTML: sin caché → el usuario siempre recibe la versión más reciente
<FilesMatch "\.(html|htm)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires 0
</FilesMatch>

# CSS / JS / imágenes: caché largo → la versión (APP_V) fuerza descarga al cambiar
<FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|ico|webp)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
